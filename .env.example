# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# App database. Local dev uses the compose `dev` profile; production uses a Neon pooled URL.
DATABASE_URL=postgres://vidora:vidora@localhost:5433/vidora

# Public URL of the web app. n8n sends callbacks here.
APP_URL=http://localhost:3010
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Where the worker triggers n8n. Host-run worker: localhost. Worker in compose: http://n8n:5678/...
N8N_WEBHOOK_URL=http://localhost:5678/webhook/vidora/generate

# Webhook signing (docs/PLAN.md §4.4). One secret per direction.
# To rotate: put the new secret first, keep the old one after a comma until both sides are updated.
VIDORA_TO_N8N_SECRET=
N8N_TO_VIDORA_SECRET=

# How n8n (inside Docker) reaches the web app on your machine.
N8N_VIDORA_APP_URL=http://host.docker.internal:3010

# n8n internals
N8N_DB_PASSWORD=
N8N_RUNNERS_AUTH_TOKEN=
N8N_ENCRYPTION_KEY=

# /design-system in production builds
ENABLE_DESIGN_SYSTEM=false

# ── Auth (Better Auth) ──────────────────────────────────────────────────────
# Signs session cookies. 32+ random bytes.
BETTER_AUTH_SECRET=
# Email sign-in links and verification emails. Without RESEND_API_KEY, links are printed to the web app's log.
RESEND_API_KEY=
EMAIL_FROM=Vidora <hello@example.com>

# ── Google (sign-in with Google, and connecting YouTube) ─────────────────────
# One OAuth client in Google Cloud. Authorized redirect URIs:
#   {APP_URL}/api/auth/callback/google        (sign in with Google, optional)
#   {APP_URL}/api/connect/youtube/callback    (connect YouTube)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Until Google's YouTube API audit passes, uploads are private. Set true only after the audit.
YOUTUBE_AUDITED=false
# Local only: without Google credentials, "Connect YouTube" uses a fake channel and posts are simulated.
# Never enable in production (it's ignored when NODE_ENV=production).
ALLOW_FAKE_YOUTUBE=false

# OAuth tokens in connected_accounts are encrypted with these keys (AES-256-GCM).
# Format: <version>:<64 hex chars>, newest first. To rotate, add a new version in front and keep the old one.
TOKEN_ENCRYPTION_KEYS=
# Signs the OAuth state for the connect flow.
OAUTH_STATE_SECRET=

# ── Storage (Cloudflare R2 in production, MinIO locally) ────────────────────
# R2: STORAGE_ENDPOINT=https://<account id>.r2.cloudflarestorage.com, STORAGE_REGION=auto, path style off.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=vidora-dev
STORAGE_ACCESS_KEY_ID=vidora
STORAGE_SECRET_ACCESS_KEY=vidora-dev-secret
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=true
